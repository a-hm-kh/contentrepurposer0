{
  "name": "contentrepurposer",
  "version": "0.2.0",
  "private": true,
  "description": "Turn one piece of content into a complete publishing plan - LinkedIn, X, Instagram, Facebook posts with smart review and weekly planning.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.2.1",
    "geist": "^1.8.1",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  }
}
