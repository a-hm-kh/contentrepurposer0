# ─────────────────────────────────────────────────────────────
# ContentRepurposer — Environment Variables
#
# Copy this file to `.env.local` and fill in your values.
# On Vercel, add the same keys in Project → Settings → Environment Variables.
# NEVER commit `.env.local` — it is gitignored on purpose.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────
# Recommended free hosts: Neon (neon.tech) or Supabase (supabase.com)
# DATABASE_URL  → the pooled connection (used at runtime)
# DIRECT_URL    → the direct connection (used by `prisma db push` / migrations)
DATABASE_URL="postgresql://user:password@host:5432/contentrepurposer?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/contentrepurposer?sslmode=require"

# ── Authentication (Auth.js v5 / NextAuth) ───────────────────
# Generate a secure secret:  openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-secret-here"
# Public base URL of the deployed app (used for OAuth redirects + checkout returns)
AUTH_URL="https://your-domain.com"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI:  https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Admin Access ────────────────────────────────────────────
# Comma-separated list of admin emails. Any account signing in with one of
# these emails is promoted to ADMIN automatically. Only these users can open
# the private dashboard at /admin/dashboard.
ADMIN_EMAILS="your-email@gmail.com"

# ── AI Providers (failover: primary → backup → optional) ─────
# At least ONE key is required. Names never surface in the UI.
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional model overrides
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_MODEL="gpt-4o-mini"

# ── Application Limits ───────────────────────────────────────
# Free generations (lifetime, never renews)
FREE_GENERATIONS=10
# Requests per IP per minute
RATE_LIMIT_PER_MINUTE=10
# Max input characters
MAX_INPUT_CHARS=20000

# ── Lemon Squeezy (Payments) ─────────────────────────────────
# API keys: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
# The Pro subscription variant (Pro plan — $15/month)
LEMONSQUEEZY_SUBSCRIPTION_VARIANT_ID=""
# Webhook signing secret: https://app.lemonsqueezy.com/settings/webhooks
# Webhook URL to register:  https://your-domain.com/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Where the "Upgrade to Pro" button sends visitors (falls back to /dashboard/billing)
NEXT_PUBLIC_PRO_URL="/dashboard/billing"

# Public base URL used by the server to build absolute redirect links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Newsletter / Notifications (optional) ────────────────────
NEWSLETTER_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
