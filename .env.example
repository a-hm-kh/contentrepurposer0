# ─────────────────────────────────────────────────────────────
# ContentRepurposer — environment variables
#
# Copy this file to `.env.local` and fill in your values:
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   macOS / Linux:         cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── AI engine ────────────────────────────────────────────────
# Names of the underlying services are intentionally kept
# server-side. Add at least one; adding both enables automatic
# failover so generation never breaks.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional third engine (extra safety net)
OPENAI_API_KEY=

# Optional model overrides
# GROQ_MODEL=
# GEMINI_MODEL=
# OPENAI_MODEL=

# ── Limits ───────────────────────────────────────────────────
# Lifetime free generations per visitor (the free package never renews).
FREE_GENERATIONS=10
# Requests allowed per IP per minute.
RATE_LIMIT_PER_MINUTE=10
# Hard cap on pasted text length.
MAX_INPUT_CHARS=20000

# ── Paid plan ────────────────────────────────────────────────
# Checkout link (Stripe / Lemon Squeezy / Gumroad…).
# While empty, the upgrade button shows "coming soon" instead.
NEXT_PUBLIC_PRO_URL=

# ── Email updates (optional) ─────────────────────────────────
# New subscribers are always saved to data/subscribers.json.
# Optionally forward them anywhere:
#   - any webhook (Zapier / Make / n8n / Buttondown / ConvertKit)
NEWSLETTER_WEBHOOK_URL=
#   - your own Telegram bot (this is the hook for the bot you'll build later)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
